{
  "name": "acme-book",
  "version": "0.14.0",
  "private": true,
  "description": "Appointment booking for small clinics and studios",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.json && vite build",
    "start": "NODE_ENV=production node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "seed": "tsx server/db/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "better-sqlite3": "12.10.1",
    "drizzle-orm": "0.44.7",
    "express": "5.1.0",
    "express-session": "1.18.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.16.0",
    "zod": "4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.3",
    "@types/express-session": "1.18.2",
    "@types/node": "24.19.0",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.4",
    "drizzle-kit": "0.31.8",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.0",
    "globals": "17.10.0",
    "jsdom": "30.1.1",
    "supertest": "7.1.4",
    "tsx": "4.23.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.1.0",
    "vitest": "5.0.3"
  }
}
